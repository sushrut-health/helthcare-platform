# ===================================================
# SUSHRUT HEALTHCARE PLATFORM - BACKEND ENVIRONMENT
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL Database
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Or direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# JWT Secrets
ACCESS_TOKEN_SECRET=sushrut_dev_access_token_secret_key_change_in_production_2026
REFRESH_TOKEN_SECRET=sushrut_dev_refresh_token_secret_key_change_in_production_2026
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# File Storage Provider ('local' or 's3')
FILE_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=../storage

# S3 Compatible Storage (for production when FILE_STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_BUCKET=sushrut-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email Provider Configuration (Optional)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@sushruthealth.in
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
